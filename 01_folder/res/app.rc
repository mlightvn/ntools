1 ICON "app.ico"
1 24 "app.manifest"

// Version shown in Properties -> Details. Keep in step with app.manifest (assemblyIdentity version).
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Nguyen Ngoc Nam"
      VALUE "FileDescription", "nExplorer"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "nexplorer"
      VALUE "LegalCopyright", "(c) 2026 Nguyen Ngoc Nam - MIT License"
      VALUE "OriginalFilename", "nexplorer.exe"
      VALUE "ProductName", "nExplorer"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
